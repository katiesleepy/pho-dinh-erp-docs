  <Code>Public Class RFuns
    Public Shared DecimalSplit As String = ","
    Public Shared ScalingSplit As String = "."

    Public Shared Function NumberToString(ByVal n As Double, cFormat As String) As String
        If n = 0 Then Return ""
        Return n.ToString(cFormat)
    End Function
    Public Shared Function NumberToString(ByVal n As Double, digit As Integer) As String
        If n = 0 Then Return ""
        Dim cFormat As String = "###,###,###,###,###,##0.".Replace(",", DecimalSplit).Replace(".", ScalingSplit) + Microsoft.VisualBasic.Left("0000000000000000", digit)
        Return n.ToString(cFormat)
    End Function

    Public Shared Function Replace(ByVal cText As String, ParamArray s As String()) As String
        For i As Integer = 0 To s.Length - 1
            cText = cText.Replace("%s" + (i + 1).ToString, s(i))
        Next
        Return cText
    End Function

    Public Shared Function ReplaceDate(ByVal cText As String, d As Date) As String
        Return Replace(cText, d.ToString("dd"), d.ToString("MM"), d.ToString("yyyy"))
    End Function
    Public Shared Function ReplaceDate(ByVal cText As String, d1 As Date, d2 As Date) As String
        Return Replace(cText, d1.ToString("dd/MM/yyyy"), d2.ToString("dd/MM/yyyy"))
    End Function

    Public Shared Function PrintFooterDateTime(ByVal cText As String) As String
        Return Replace(cText, Now.ToString("yyyy-MM-dd HH:mm:ss"))
    End Function
    Public Shared Function PrintFooterDateTime(ByVal cText As String, ByVal xType As String) As String
        If xType = "2" Then
            Return Replace(cText, Now.ToString("yyyy-MM-dd"))
        ElseIf xType = "3" Then
            Return Replace(cText, Now.ToString("yyyy-MM-dd HH:mm:ss"))
        Else
            Return ""
        End If
    End Function
	Public Shared Function PrintFooterPageNumber(ByVal cText As String, ByVal xType As String, ByVal cPage As String, ByVal cTotalPage As String) As String
		If xType = "0" Then
            Return ""
        Else
            Return Replace(cText, cPage, cTotalPage)
        End If
    End Function
End Class</Code>
